# Cell 7: Copy Files to YOLOv8 Structure
print("\n Copying files to YOLOv8 structure...")

def copy_dataset_split(source_images, target_image_dir, target_label_dir):
    """Copy images and their corresponding labels"""
    images_copied = 0
    labels_copied = 0

    for img_path in source_images:
        try:
            # Copy image
            img_filename = os.path.basename(img_path)
            shutil.copy(img_path, os.path.join(target_image_dir, img_filename))
            images_copied += 1

            # Find and copy corresponding label
            label_path = img_path.replace('/images/', '/labels/').replace('.jpg', '.txt').replace('.jpeg', '.txt').replace('.png', '.txt')

            if os.path.exists(label_path):
                shutil.copy(label_path, os.path.join(target_label_dir, os.path.basename(label_path)))
                labels_copied += 1
            else:
                print(f"Label not found for: {img_filename}")

        except Exception as e:
            print(f"Error copying {img_path}: {e}")

    return images_copied, labels_copied

# Copy training data
