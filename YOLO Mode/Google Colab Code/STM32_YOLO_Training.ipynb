# === MODIFIED CELL 10: Create STM32H750-Optimized Model (FIXED) ===
print("\n Creating STM32H750-optimized compressed model...")

def create_stm32_optimized_model():
    """Create a highly compressed model for STM32H750"""

    # Use Ultralytics' built-in tiny architecture with custom modifications
    model = YOLO('yolov8n.pt')  # Start with working nano model

    # Apply compression through training configuration instead of custom YAML
    return model

# Initialize with working model
model = create_stm32_optimized_model()

# === MODIFIED CELL 11: STM32-Optimized Training ===
training_config = {
    'data': f'{yolov8_path}/data.yaml',
    'epochs': 150,
    'imgsz': 320,   # Smaller input for STM32
    'batch': 32,
    'workers': 4,
    'lr0': 0.001,
    'lrf': 0.001,
    'momentum': 0.937,
    'weight_decay': 0.001,
    'patience': 25,
    'save': True,
    'cache': False,
    'device': 0,
    'project': 'stm32-submarine-detection',
    'name': 'stm32h750_compressed',
    'exist_ok': True,
    'pretrained': True,  # Keep this True for transfer learning
    'optimizer': 'AdamW',
    'single_cls': True,
    'plots': True,
    'amp': True,
    'cos_lr': True,
    'close_mosaic': 10,
}

print("STM32H750 Training Configuration:")
for key, value in list(training_config.items())[:10]:
    print(f"   {key}: {value}")

# === CELL 12: Start Training ===
print("\n Starting STM32H750-optimized training...")
results = model.train(**training_config)
print("STM32-optimized training completed!")

# === NEW CELL: Apply Post-Training Compression ===
print("\n Applying post-training compression...")

def apply_model_compression():
    """Apply compression techniques to the trained model"""

    # Load the best trained model
    model_path = "/content/stm32-submarine-detection/stm32h750_compressed/weights/best.pt"
    compressed_model = YOLO(model_path)

    print("Original model analysis:")
    total_params = sum(p.numel() for p in compressed_model.model.parameters())
    print(f"   Parameters: {total_params:,}")
    print(f"   Size (FP32): {total_params * 4 / (1024*1024):.2f} MB")

    return compressed_model

# Apply compression
compressed_model = apply_model_compression()

# === MODIFIED CELL 14: Enhanced Export with Compression ===
print("\n Exporting compressed models for STM32H750...")

# Method 1: TFLite with heavy quantization
try:
    compressed_model.export(
        format='tflite',
        int8=True,
        imgsz=320,
        simplify=True
    )
    print("Quantized TFLite (INT8) exported")
except Exception as e:
    print(f"TFLite INT8 failed: {e}")
    try:
        compressed_model.export(format='tflite', imgsz=320)
        print("TFLite (FP32) exported")
    except Exception as e2:
        print(f"TFLite FP32 failed: {e2}")

# Method 2: ONNX with optimization
try:
    compressed_model.export(
        format='onnx',
        imgsz=320,
        simplify=True,
        dynamic=False,
        opset=12
    )
    print("ONNX exported with optimization")
except Exception as e:
    print(f"ONNX export failed: {e}")

# Method 3: Try different quantization
try:
    compressed_model.export(format='torchscript', imgsz=320)
    print("TorchScript exported")
except Exception as e:
    print(f"TorchScript failed: {e}")

